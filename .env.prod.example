# =============================================================================
# Plane (Francu Digital) — PRODUCTION environment, ROOT .env (host-side)
# =============================================================================
# Copy to `.env` on the Ubuntu host and fill in:
#     cp .env.prod.example .env
# `.env` is gitignored and must never be committed.
#
# This file feeds docker-compose.prod.yml (postgres/rabbitmq/minio credentials
# and the proxy's file-size limit). The APPLICATION config lives in a SECOND
# file — apps/api/.env — see apps/api/.env.prod.example. Both are required.
#
# NOTE vs. upstream .env.example: LISTEN_HTTP_PORT / LISTEN_HTTPS_PORT and the
# CERT_* / SITE_ADDRESS vars are GONE. This stack publishes no host ports and
# terminates nothing — the shared edge Caddy (devops-francu) owns :80 on this
# host and proxies plane.francugroup.ro to plane-proxy:80.
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# CHANGE THESE. The upstream defaults are plane/plane.
POSTGRES_USER="plane"
POSTGRES_PASSWORD="CHANGE-ME-strong-password"
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

# --- Redis / Valkey ----------------------------------------------------------
REDIS_HOST="plane-redis"
REDIS_PORT="6379"

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="CHANGE-ME-strong-password"
RABBITMQ_VHOST="plane"

# --- Object storage (MinIO) --------------------------------------------------
# Self-hosted MinIO, fronted by Plane's own proxy at /uploads/. These two values
# are the MinIO root credentials AND the S3 access keys the API signs with —
# they must match apps/api/.env.
AWS_REGION=""
AWS_ACCESS_KEY_ID="CHANGE-ME-access-key"
AWS_SECRET_ACCESS_KEY="CHANGE-ME-secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing the bucket name requires the same change in apps/api/.env — the
# proxy routes /${AWS_S3_BUCKET_NAME}/* to MinIO.
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit (bytes). Enforced by the proxy's request_body cap.
FILE_SIZE_LIMIT=5242880

# --- Proxy -------------------------------------------------------------------
# The edge Caddy is the only thing in front of plane-proxy, so trust its
# X-Forwarded-For. Both containers are on the `edge` bridge network.
TRUSTED_PROXIES=0.0.0.0/0
