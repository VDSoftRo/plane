# =============================================================================
# Plane (Francu Digital) — PRODUCTION environment, API .env (host-side)
# =============================================================================
# Copy to `apps/api/.env` on the Ubuntu host and fill in:
#     cp apps/api/.env.prod.example apps/api/.env
# `.env` is gitignored and must never be committed.
#
# Loaded by api / worker / beat-worker / migrator in docker-compose.prod.yml.
#
# -----------------------------------------------------------------------------
# CRITICAL: hostname correlations
# -----------------------------------------------------------------------------
# Serving Plane at http://plane.francugroup.ro instead of localhost changes the
# browser's Origin, and several settings must agree or things break in ways that
# do NOT look like a proxy problem:
#
#   CORS_ALLOWED_ORIGINS  — must contain the exact public origin, or LOGIN and
#                           every XHR fail CORS. Exact string match, NO trailing
#                           slash. (apps/api/plane/settings/common.py:180)
#
#   WEB_URL               — with USE_MINIO=1 this becomes AWS_S3_CUSTOM_DOMAIN,
#                           i.e. the host baked into EVERY uploaded file URL. If
#                           it says localhost, all avatars and attachments render
#                           as broken links. (common.py:314)
#                           It is also the base for emailed links (invites,
#                           magic-link login), so a wrong value sends users to a
#                           URL they cannot reach.
#
#   *_BASE_URL            — must be the public origin, not localhost:300x. These
#                           are what the app hands the browser to reach the
#                           admin / spaces / live sub-apps.
#
# Change the domain in one place and you must change it in ALL of them.
# -----------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
# 0 in production. Never ship DEBUG=1.
DEBUG=0

# REQUIRED. Generate a fresh one — do NOT reuse the checked-in dev value:
#     python -c 'import secrets; print(secrets.token_urlsafe(50))'
# Also encrypts InstanceConfiguration secrets (incl. the SMTP password set in
# the admin panel), so rotating this invalidates them and they must be re-entered.
SECRET_KEY="CHANGE-ME-generate-a-fresh-secret"

# Exact public origin(s). No trailing slash.
CORS_ALLOWED_ORIGINS="http://plane.francugroup.ro"

# --- Database ----------------------------------------------------------------
# Must match the root .env (docker-compose.prod.yml passes those to postgres).
POSTGRES_USER="plane"
POSTGRES_PASSWORD="CHANGE-ME-strong-password"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis -------------------------------------------------------------------
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# --- RabbitMQ ----------------------------------------------------------------
# Must match the root .env.
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="CHANGE-ME-strong-password"
RABBITMQ_VHOST="plane"

# --- Object storage (MinIO) --------------------------------------------------
# USE_MINIO=1 selects the bundled MinIO. Note the upstream example ships 0 here
# while the root .env ships 1 — that mismatch breaks uploads, so both files are
# set to the MinIO setup consistently.
USE_MINIO=1
AWS_REGION=""
# Must match the root .env (they are MinIO's root credentials).
AWS_ACCESS_KEY_ID="CHANGE-ME-access-key"
AWS_SECRET_ACCESS_KEY="CHANGE-ME-secret-key"
# Internal endpoint the API signs/uploads against, over plane-net.
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

# Uploads are served over plain HTTP through the edge proxy (VPN-only, no TLS).
# Set to 1 when TLS is added at the edge, or file URLs will be built as http://
# on an https:// page and get blocked as mixed content.
MINIO_ENDPOINT_SSL=0

DOCKERIZED=1 # deprecated

# --- Public URLs -------------------------------------------------------------
# See the CRITICAL block at the top. All of these are the public origin.
WEB_URL="http://plane.francugroup.ro"

APP_BASE_URL="http://plane.francugroup.ro"
APP_BASE_PATH=""

ADMIN_BASE_URL="http://plane.francugroup.ro"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://plane.francugroup.ro"
SPACE_BASE_PATH="/spaces"

LIVE_BASE_URL="http://plane.francugroup.ro"
LIVE_BASE_PATH="/live"

# Shared secret between the API and the live (collaboration) server.
LIVE_SERVER_SECRET_KEY="CHANGE-ME-generate-a-fresh-secret"

# --- Runtime -----------------------------------------------------------------
GUNICORN_WORKERS=2
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT="60/minute"

# --- SMTP (optional here — configured from the admin panel) -------------------
# SMTP is set at http://plane.francugroup.ro/god-mode/email after first boot.
#
# Why it's optional here: SKIP_ENV_VAR defaults to "1", so at RUNTIME the API
# reads email config from the instance_configurations DB table, NOT from this
# file (plane/license/utils/instance_value.py:19). These env vars only SEED that
# table, on the first boot, via `manage.py configure_instance` — which uses
# get_or_create, so once the rows exist they are never overwritten from env.
#
# In other words: setting these AFTER the first deploy does nothing. Use the
# admin panel. They're listed only so a fresh instance can be seeded, and for
# reference on what the admin form writes.
#
# ENABLE_SMTP=1
# EMAIL_HOST="smtp.example.com"
# EMAIL_PORT=587
# EMAIL_HOST_USER="no-reply@francugroup.ro"
# EMAIL_HOST_PASSWORD=""
# EMAIL_FROM="Plane | Francu Digital <no-reply@francugroup.ro>"
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
