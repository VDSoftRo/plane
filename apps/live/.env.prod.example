# =============================================================================
# Plane (Francu Digital) — PRODUCTION, LIVE server .env (host-side)
# =============================================================================
# Copy to `apps/live/.env` on the Ubuntu host:
#     cp apps/live/.env.prod.example apps/live/.env
# `.env` is gitignored and must never be committed.
#
# The live server powers collaborative document editing. It validates this
# config with zod at startup (apps/live/src/env.ts) and EXITS 1 if anything
# required is missing, so a wrong value here shows up as a crash-looping
# container rather than a degraded feature. Check it with:
#     docker compose -f docker-compose.prod.yml logs live
# -----------------------------------------------------------------------------

# Port the server listens on INSIDE the container. Must stay 3000: Plane's
# internal proxy routes /live/* to live:3000 (apps/proxy/Caddyfile.ce) and the
# Dockerfile EXPOSEs 3000. The dev example's 3100 is for running it on the host
# directly — using it here breaks the proxy route.
PORT=3000

# REQUIRED, no default. Internal URL of the API, over plane-net — this is
# server-to-server, so it is the container name, NOT the public hostname.
# Must be a valid URL or zod rejects it.
API_BASE_URL="http://api:8000"

# REQUIRED, no default. Shared secret authenticating the live server to the
# API. MUST match LIVE_SERVER_SECRET_KEY in apps/api/.env exactly, or every
# collaborative session is rejected by the auth middleware
# (apps/live/src/lib/auth-middleware.ts).
LIVE_SERVER_SECRET_KEY="CHANGE-ME-must-match-apps/api/.env"

# Public origins allowed to open a live connection. This one IS the public
# hostname (the browser makes this connection, unlike API_BASE_URL above).
CORS_ALLOWED_ORIGINS="http://plane.francugroup.ro"

# Path the live server is mounted at, matching the proxy route and
# LIVE_BASE_PATH in apps/api/.env.
LIVE_BASE_PATH="/live"

# Redis, for sharing document state across connections. Internal names again.
REDIS_HOST="plane-redis"
REDIS_PORT=6379
REDIS_URL="redis://plane-redis:6379/"
